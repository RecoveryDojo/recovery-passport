# Recovery Passport — Environment Variables
# Copy this file to .env and fill in the values from your own Supabase project.

# Your Supabase project URL
# Example: https://<project-ref>.supabase.co
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Your Supabase anon/public publishable key
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Your Supabase project reference (the <project-ref> part of the URL)
VITE_SUPABASE_PROJECT_ID=your-project-ref
